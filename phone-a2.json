  "grammar": [
    {
      "id": "remote-phone-grammar-1",
      "title": {
        "fr": "Pouvoir / vouloir au téléphone",
        "en": "Pouvoir and vouloir on the phone",
        "es": "Pouvoir y vouloir al teléfono",
        "ru": "Пувуар и вуруар по телефону"
      },
      "rule": {
        "fr": "Pouvoir et vouloir sont très utiles : Tu peux me rappeler ? Je voudrais parler à… Formes : je peux, tu peux, il peut ; je veux / je voudrais (plus poli).",
        "en": "Being able and wanting are very useful: Can you call me back? I would like to speak to... Forms: I can, you can, he can; I want / I would like (more polite).",
        "es": "Poder y querer son muy útiles: ¿Puedes devolverme la llamada? Me gustaría hablar con... Formas: Yo puedo, tú puedes, él puede; Quiero/me gustaría (más educado).",
        "ru": "Уметь и хотеть очень полезно: Ты можешь мне перезвонить? Я хотел бы поговорить с... Формы: Я могу, ты можешь, он может; Я хочу/мне хотелось бы (более вежливо)."
      },
      "table": [
        [
          "Verbe",
          "Présent",
          "Exemple"
        ],
        [
          "pouvoir",
          "je peux / tu peux",
          "Tu peux m’envoyer un message ?"
        ],
        [
          "vouloir",
          "je veux",
          "Je veux un nouveau forfait."
        ],
        [
