          "Il fait + adj.",
          "température / conditions",
          "Il fait chaud."
        ],
        [
          "Il y a + nom",
          "présence",
          "Il y a du vent."
        ],
        [
          "Il pleut",
          "pluie",
          "Il pleut ce matin."
        ],
        [
          "Il neige",
          "neige",
          "Il neige en hiver."
