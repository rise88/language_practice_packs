  "grammar": [
    {
      "id": "remote-weather-grammar-1",
      "title": {
        "fr": "Il fait / Il y a",
        "en": "Describing the weather",
        "es": "Describiendo el clima",
        "ru": "Описание погоды"
      },
      "rule": {
        "fr": "Pour décrire le temps qu’il fait, on utilise Il fait + adjectif (Il fait chaud, Il fait froid, Il fait beau) ou Il y a + nom (Il y a du soleil, Il y a du vent). Pour la pluie et la neige, on utilise Il pleut / Il neige.",
        "en": "To describe the weather, we use It's + adjective (It's hot, It's cold, It's nice) or There's + noun (It's sunny, It's windy). For rain and snow, we use It's raining / It's snowing.",
        "es": "Para describir el clima, usamos It's + adjetivo (Hace calor, Hace frío, Hace agradable) o There's + sustantivo (Hace sol, Hace viento). Para lluvia y nieve, usamos Está lloviendo / Está nevando.",
        "ru": "Для описания погоды мы используем It's + прилагательное (Жарко, Холодно, Хорошо) или Theres + существительное (Солнечно, Ветрено). Для дождя и снега мы используем Идет дождь/Идет снег."
      },
      "table": [
        [
          "Expression",
          "Usage",
          "Exemple"
        ],
        [
          "Il fait + adj.",
          "température / conditions",
          "Il fait chaud."
        ],
        [
          "Il y a + nom",
          "présence",
          "Il y a du vent."
        ],
        [
          "Il pleut",
          "pluie",
          "Il pleut ce matin."
        ],
        [
          "Il neige",
          "neige",
          "Il neige en hiver."
        ]
      ],
