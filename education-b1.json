  "grammar": [
    {
      "id": "remote-education-grammar-1",
      "title": {
        "fr": "Passé composé pour les résultats",
        "en": "Passé composé for results"
      },
      "rule": {
        "fr": "Pour un résultat d’études : passé composé. J’ai obtenu mon diplôme. Elle a rendu son devoir. Accord du participe avec être et avec avoir + COD placé avant."
      },
      "table": [
        [
          "Auxiliaire",
          "Exemple",
          "Accord"
        ],
        [
          "avoir",
          "J’ai réussi l’examen.",
          "pas d’accord (COD après)"
        ],
        [
          "avoir + COD avant",
          "Je l’ai réussie.",
          "accord avec la"
        ],
        [
          "être",
          "Elle est entrée à l’université.",
          "accord avec le sujet"
        ],
        [
          "venir de",
          "Je viens de finir.",
          "passé récent"
        ]
      ],
      "questions": [
        {
          "id": "remote-education-gq-1",
          "prompt": "J’___ mon diplôme l’an dernier.",
          "answer": "ai obtenu",
          "options": [
            "ai obtenu",
            "obtenais",
            "obtiendrai"
          ]
        },
        {
          "id": "remote-education-gq-2",
          "prompt": "Elle ___ son devoir hier.",
          "answer": "a rendu",
          "options": [
            "a rendu",
            "rendait",
            "rendra"
          ]
        },
        {
          "id": "remote-education-gq-3",
          "prompt": "Je ___ de finir mes révisions.",
          "answer": "viens",
          "options": [
            "viens",
            "vais",
            "dois"
          ]
        }
      ],
      "why": {}
    },
    {
      "id": "remote-education-grammar-2",
      "title": {
        "fr": "Pour / afin de + infinitif",
        "en": "Purpose with pour / afin de"
      },
      "rule": {
        "fr": "Pour exprimer le but : pour + infinitif (plus courant) ou afin de + infinitif (plus soutenu). Je révise pour réussir. Afin de gagner du temps, je planifie."
      },
      "table": [
        [
          "Forme",
          "Registre",
          "Exemple"
        ],
        [
          "pour + inf.",
          "courant",
          "pour réussir l’examen"
        ],
        [
          "afin de + inf.",
          "soutenu",
          "afin de mieux comprendre"
        ],
        [
          "pour que + subj.",
          "but avec changement de sujet",
          "pour que tu réussisses"
        ],
        [
          "histoire de",
          "familier",
          "histoire de gagner du temps"
        ]
      ],
      "questions": [
        {
          "id": "remote-education-gq-4",
          "prompt": "Je révise ___ réussir.",
          "answer": "pour",
          "options": [
            "pour",
            "par",
            "pendant"
          ]
        },
        {
          "id": "remote-education-gq-5",
          "prompt": "___ de gagner du temps, elle planifie.",
          "answer": "Afin",
          "options": [
            "Afin",
            "Pour que",
            "Depuis"
          ]
        }
      ],
      "why": {}
    }
  ],
