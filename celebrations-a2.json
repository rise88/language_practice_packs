  "grammar": [
    {
      "id": "remote-celebrations-grammar-1",
      "title": {
        "fr": "Inviter : tu veux / on peut",
        "en": "Inviting someone",
        "es": "invitar a alguien",
        "ru": "Приглашение кого-то"
      },
      "rule": {
        "fr": "Pour inviter : Tu veux venir samedi ? On peut se retrouver à vingt heures. Pour refuser poliment : Désolé, je ne peux pas. J’aimerais + infinitif est plus doux.",
        "en": "To invite: Do you want to come on Saturday? We can meet at eight o'clock. To politely decline: Sorry, I can't. I would like + infinitive is softer.",
        "es": "Para invitar: ¿Quieres venir el sábado? Podemos reunirnos a las ocho en punto. Para rechazar cortésmente: Lo siento, no puedo. Me gustaría + infinitivo es más suave.",
        "ru": "Пригласить: Хочешь прийти в субботу? Мы можем встретиться в восемь часов. Чтобы вежливо отказаться: Извините, я не могу. Я бы хотел + инфинитив мягче."
      },
      "table": [
        [
          "Expression",
